{
	"name": "@pajecawav/tools",
	"version": "0.0.7",
	"type": "module",
	"license": "MIT",
	"homepage": "https://github.com/pajecawav/tools#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/pajecawav/tools.git"
	},
	"bugs": {
		"url": "https://github.com/pajecawav/tools/issues"
	},
	"exports": {
		".": "./dist/index.mjs",
		"./cli": "./dist/cli/index.mjs",
		"./package.json": "./package.json"
	},
	"bin": {
		"pt": "./dist/cli/index.mjs"
	},
	"files": [
		"dist",
		"src"
	],
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch",
		"dev:cli": "tsx --tsconfig tsconfig.lib.json ./src/cli/index.ts",
		"cli": "node ./dist/cli/index.mjs",
		"lint": "cross-env FORCE_COLOR=1 run-p -l lint:*",
		"lint:oxlint": "oxlint .",
		"lint:tsc": "tsc -b --noEmit",
		"lint:format": "oxfmt --check",
		"lint:package": "publint",
		"format": "oxfmt . --write",
		"prepare": "husky",
		"prepublishOnly": "npm-run-all -p -l lint:* -s build"
	},
	"peerDependencies": {
		"oxfmt": "^0.59.0",
		"oxlint": "^1.74.0",
		"prettier": "^3.9.5"
	},
	"peerDependenciesMeta": {
		"oxfmt": {
			"optional": true
		},
		"oxlint": {
			"optional": true
		},
		"prettier": {
			"optional": true
		}
	},
	"dependencies": {
		"@commitlint/config-conventional": "^21.2.0",
		"@commitlint/types": "^21.2.0",
		"@pajecawav/prettier-config": "^1.0.2",
		"c12": "4.0.0-beta.5",
		"citty": "^0.2.2",
		"consola": "^3.4.2",
		"defu": "^6.1.7",
		"execa": "^10.0.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.2.0"
	},
	"devDependencies": {
		"@types/node": "^24.13.3",
		"cross-env": "^10.1.0",
		"npm-run-all2": "^9.0.2",
		"oxfmt": "^0.60.0",
		"oxlint": "^1.75.0",
		"oxlint-tsgolint": "^7.0.2001",
		"publint": "^0.3.22",
		"tsdown": "^0.22.14",
		"tsx": "^4.23.1",
		"typescript": "^7.0.2"
	},
	"packageManager": "pnpm@11.17.0+sha512.cca3cea332ad254bb84145f966d19f4879615210346fc92c79a047f23a0d7b3cca3c3792f0076ba1f1831d277efbcf0a9119b31a9a60eca7fb3d6231f331ef72"
}
